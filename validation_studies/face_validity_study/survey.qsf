Header": "", "Footer": "", "ProgressBarDisplay": "VerboseText", "PartialData": "+1 week", "ValidationMessage": "", "PreviousButton": " ← ", "NextButton": " → ", "SurveyTitle": "Classifying questions people disagree about", "SkinLibrary": "", "SkinType": "templated", "Skin": {"brandingId": null, "templateId": "*base", "overrides": {"colors": {"secondary": "#2F2E2A", "primary": "#2F2E2A"}, "contrast": 1, "layout": {"spacing": 0}, "questionText": {"size": "19px"}}}, "NewScoring": 1, "SurveyMetaDescription": "A short study about which questions the public disputes and who disputes them", "EOSRedirectURL": "https://app.prolific.com/submissions/complete?cc=PLACEHOLDER", "CollectGeoLocation": "false", "ShowExportTags": "false", "AnonymizeResponse": "Yes", "EmailThankYou": "false", "ThankYouEmailMessage": null, "ThankYouEmailMessageLibrary": null, "PageTransition": "slide", "CustomStyles": {"customCSS": ".Skin #Buttons {text-align:center;}\n@media (min-width: 900px) { .Skin .SkinInner {min-width: 880px!important;} }\n.Skin .SkinInner {padding-top: 28px;}\n.Skin body {background:#FBFAF6;}\n.Skin .QuestionText {border:none;}\n"}}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID1", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "Browser Meta Info", "QuestionType": "Meta", "Selector": "Browser", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "DataExportTag": "browser_meta", "Choices": {"1": {"Display": "Browser", "TextEntry": 1}, "2": {"Display": "Version", "TextEntry": 1}, "3": {"Display": "Operating System", "TextEntry": 1}, "4": {"Display": "Screen Resolution", "TextEntry": 1}, "5": {"Display": "Flash Version", "TextEntry": 1}, "6": {"Display": "Java Support", "TextEntry": 1}, "7": {"Display": "User Agent", "TextEntry": 1}}, "QuestionID": "QID1"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID10", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Is there more carbon dioxide in the air now than at any time in the last 800,000 years?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Ice core records show carbon dioxide never went above about 300 parts per million in the last 800,000 years, and it is now above 420.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe today's carbon dioxide level is nothing unusual, the Earth has had far more of it many times before.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S003", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S003\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID10"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID100", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Can someone who has had an mRNA COVID-19 vaccine shed it to other people?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. The vaccines contain no live virus and nothing is transmitted from a vaccinated person to anyone else.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that people who have had an mRNA COVID vaccine can shed it onto others around them.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S033", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S033\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID100"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID101", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S033", "QuestionID": "QID101"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID102", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S033", "QuestionID": "QID102"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID103", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do too many vaccines at once overwhelm a young child's immune system?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Studies comparing children who followed the full schedule with children who received fewer vaccines at once find no difference in immune function or in later infections, and expert reviews of the combined schedule find no evidence of harm.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe giving a baby that many vaccines at once overwhelms their immune system.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S034", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S034\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID103"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID104", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S034", "QuestionID": "QID104"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID105", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S034", "QuestionID": "QID105"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID106", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does ivermectin treat COVID-19?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Large randomised trials found no benefit for preventing or treating COVID-19.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that ivermectin treats COVID and that the cure was suppressed.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S035", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S035\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID106"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID107", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S035", "QuestionID": "QID107"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID108", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S035", "QuestionID": "QID108"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID109", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did hydroxychloroquine reduce COVID-19 deaths?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. The RECOVERY trial and other randomised trials found no reduction in deaths, and the US emergency authorisation was revoked.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that hydroxychloroquine cut COVID deaths and was held back for political reasons.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S036", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S036\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID109"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID11", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S003", "QuestionID": "QID11"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID110", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S036", "QuestionID": "QID110"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID111", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S036", "QuestionID": "QID111"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID112", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">In the United States in 2020, before vaccines and widespread immunity, was COVID-19 more deadly than seasonal flu?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. In the United States in 2020 COVID-19 killed a considerably higher share of the people it infected than seasonal flu does, and it caused several hundred thousand deaths in that year against the tens of thousands in a typical flu season.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think COVID in the United States in 2020 was never any worse than a bad flu season.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S037", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S037\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID112"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID113", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S037", "QuestionID": "QID113"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID114", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S037", "QuestionID": "QID114"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID115", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Were United States COVID-19 death counts inflated by counting unrelated deaths?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Deaths from all causes ran far above the normal level during the pandemic waves, by roughly the size of the recorded COVID-19 deaths, so the national totals were not inflated by counting unrelated deaths.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that the US COVID death counts were inflated by counting people who died of something else.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S038", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S038\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID115"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID116", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S038", "QuestionID": "QID116"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID117", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S038", "QuestionID": "QID117"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID118", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did the United States see more deaths than usual in 2020?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. There were several hundred thousand more deaths than expected for the year, the largest single year rise in decades.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe 2020 saw no more deaths than a normal year in the United States.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S039", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S039\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID118"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID119", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S039", "QuestionID": "QID119"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID12", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S003", "QuestionID": "QID12"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID120", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S039", "QuestionID": "QID120"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID121", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did the 2020 United States presidential election involve fraud large enough to change the result?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Courts, state audits and recounts, and federal election security officials all found no fraud on a scale that could have changed the outcome.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that the 2020 election was stolen through fraud big enough to change the result.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S040", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S040\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID121"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID122", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S040", "QuestionID": "QID122"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID123", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S040", "QuestionID": "QID123"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID124", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did any court overturn the result of the 2020 United States presidential election?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. No court overturned the result. More than 60 lawsuits were brought challenging it; the courts dismissed or rejected them, and a number were withdrawn by the people who brought them before any ruling. The judges who ruled on them included appointees of President Trump.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think the courts never actually looked at the evidence of fraud in 2020.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S041", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S041\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID124"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID125", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S041", "QuestionID": "QID125"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID126", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S041", "QuestionID": "QID126"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID127", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did Dominion voting machines switch votes in the 2020 election?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Hand recounts of paper ballots matched the machine counts, and the claims were withdrawn or settled as false in court.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that Dominion voting machines switched votes in the 2020 election.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S042", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S042\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID127"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID128", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S042", "QuestionID": "QID128"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID129", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S042", "QuestionID": "QID129"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID13", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does carbon dioxide trap heat in the atmosphere?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Carbon dioxide absorbs and re-emits infrared radiation, which is measured in the laboratory and from satellites.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that carbon dioxide is just plant food and does not trap any heat in the atmosphere.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S004", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S004\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID13"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID130", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did the review of Maricopa County ballots in Arizona find that Trump won?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. The review, run by contractors chosen by the state senate, confirmed the Biden win in Maricopa County and put his margin 360 votes higher than the official count, with 99 more votes for Biden and 261 fewer for Trump.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that the Maricopa County ballot review in Arizona found that Trump really won.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S043", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S043\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID130"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID131", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S043", "QuestionID": "QID131"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID132", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S043", "QuestionID": "QID132"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID133", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did Georgia's hand recount change who won the state in 2020?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. The full hand recount of paper ballots confirmed the original result.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that Georgia's votes were never checked by hand, so nobody knows who really won the state.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S044", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S044\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID133"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID134", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S044", "QuestionID": "QID134"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID135", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S044", "QuestionID": "QID135"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID136", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did federal election security officials say the 2020 election was secure?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. The federal and state election security bodies called it the most secure election in American history and reported no evidence of compromised votes.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe no election security official ever vouched for the security of the 2020 count.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S045", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S045\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID136"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID137", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S045", "QuestionID": "QID137"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID138", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S045", "QuestionID": "QID138"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID139", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Were large numbers of 2020 votes cast in the names of dead people?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. State reviews and audits found documented cases in the single or low double digits per state, such as the fewer than five confirmed cases Georgia identified out of about five million ballots, against more than 150 million votes cast nationally.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that large numbers of 2020 ballots were cast in the names of dead people.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S046", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S046\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID139"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID14", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S004", "QuestionID": "QID14"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID140", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S046", "QuestionID": "QID140"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID141", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S046", "QuestionID": "QID141"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID142", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Was Barack Obama born in the United States?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. He was born in Honolulu, Hawaii in 1961, confirmed by his birth certificate and by contemporaneous newspaper birth notices.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that Barack Obama was not born in the United States.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S047", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S047\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID142"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID143", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S047", "QuestionID": "QID143"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID144", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S047", "QuestionID": "QID144"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID145", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do wind turbines cause cancer?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. No study has found a link between wind turbines and cancer, and health reviews of people living near wind farms find no evidence of such a link.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that wind turbines cause cancer in the people who live near them.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S048", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S048\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID145"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID146", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S048", "QuestionID": "QID146"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID147", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S048", "QuestionID": "QID147"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID148", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do electric cars produce less greenhouse gas than petrol cars over their lifetime?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Counting manufacture, battery production and the electricity used to charge it, lifecycle assessments find a typical electric car produces less greenhouse gas over its life than a comparable petrol car in Europe, the United States, China and India. The size of the advantage depends on the vehicle and on how the local grid generates its electricity.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe electric cars are worse for the climate than petrol cars once you count the battery.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S049", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S049\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID148"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID149", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S049", "QuestionID": "QID149"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID15", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S004", "QuestionID": "QID15"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID150", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S049", "QuestionID": "QID150"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID151", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">On the levelised cost of new generation, is new utility-scale solar power now among the cheapest sources of electricity?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. In most of the world the levelised cost of electricity from a new utility-scale solar plant is now below that of a new coal or gas plant.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that a new utility-scale solar plant still costs far more per unit of electricity than a new coal or gas plant, and is only viable because of subsidy.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S050", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S050\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID151"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID152", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S050", "QuestionID": "QID152"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID153", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S050", "QuestionID": "QID153"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID154", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Is mifepristone safe when used as approved?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. In more than two decades of use, serious adverse events are rare, at well under one per cent of users.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that mifepristone causes severe harm in a large share of the women who take it.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S051", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S051\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID154"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID155", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S051", "QuestionID": "QID155"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID156", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S051", "QuestionID": "QID156"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID157", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Were police officers injured during the attack on the United States Capitol on 6 January 2021?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. The Capitol Police and the Metropolitan Police reported that about 140 of their officers were injured that day. Separately, hundreds of people were charged with assaulting, resisting or impeding officers, and many were convicted at trial or by guilty plea before the January 2025 pardons.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe 6 January 2021 was peaceful and that no police officers were hurt.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S052", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S052\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID157"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID158", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S052", "QuestionID": "QID158"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID159", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S052", "QuestionID": "QID159"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID16", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Where does the extra carbon dioxide in the atmosphere come from?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Mostly from burning fossil fuels, with a smaller part from cement production and land use change.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that volcanoes and the ocean give off far more carbon dioxide than people do, so the rise is not ours.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S005", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S005\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID16"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID160", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did life expectancy in the United States fall during the pandemic?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. US life expectancy fell by about 2.4 years between 2019 and 2021, the largest fall since the 1920s.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that US life expectancy did not actually fall during the pandemic.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S053", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S053\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID160"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID161", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S053", "QuestionID": "QID161"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID162", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S053", "QuestionID": "QID162"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID163", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Have global carbon dioxide emissions kept rising since 1990?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Global emissions from fossil fuels are higher now than in 1990 despite falls in some countries.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think global carbon dioxide emissions have been falling since 1990.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S054", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S054\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID163"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID164", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S054", "QuestionID": "QID164"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID165", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S054", "QuestionID": "QID165"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID166", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did Donald Trump win more votes nationwide than Hillary Clinton in 2016?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Clinton received about 2.9 million more votes nationwide; Trump won the Electoral College.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that Trump won the popular vote in 2016 and that the gap came from millions of illegal votes.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S055", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S055\";\n  var prev = \"\";\n  try { 