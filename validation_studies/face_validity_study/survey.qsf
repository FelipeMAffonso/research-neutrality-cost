"ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S146", "QuestionID": "QID435"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID436", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">When did the American Civil War end?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">In 1865, with Lee's surrender at Appomattox Court House in April and the last Confederate surrenders by June.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that the American Civil War carried on well past 1865.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S147", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S147\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID436"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID437", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S147", "QuestionID": "QID437"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID438", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S147", "QuestionID": "QID438"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID439", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">How many people died in the 1918 influenza pandemic?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">At least 50 million worldwide, with some estimates higher.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that the 1918 influenza pandemic killed only a few hundred thousand people worldwide.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S148", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S148\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID439"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID44", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S014", "QuestionID": "QID44"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID440", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S148", "QuestionID": "QID440"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID441", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S148", "QuestionID": "QID441"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID442", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">How was smallpox eradicated?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">By a worldwide vaccination and containment campaign; the last natural case was in 1977 and eradication was certified in 1980.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe smallpox died out on its own rather than through a vaccination campaign.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S149", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S149\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID442"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID443", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S149", "QuestionID": "QID443"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID444", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S149", "QuestionID": "QID444"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID445", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do bicycle helmets reduce head injuries in a crash?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Meta-analysis of the crash studies finds that helmets substantially reduce the risk of serious head and brain injury.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that bicycle helmets do not reduce head injuries in a crash.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S150", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S150\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID445"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID446", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S150", "QuestionID": "QID446"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID447", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S150", "QuestionID": "QID447"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID448", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Can HIV spread through sharing a cup or a handshake?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. HIV is not spread by casual contact, saliva, cups, toilet seats or hugging.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard you can catch HIV from sharing a cup or shaking hands.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S151", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S151\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID448"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID449", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S151", "QuestionID": "QID449"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID45", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S014", "QuestionID": "QID45"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID450", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S151", "QuestionID": "QID450"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID451", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Why is the composition of the flu vaccine reviewed and often changed each year?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Because the influenza viruses in circulation change, so the strains in the vaccine are reviewed each season and updated when the circulating viruses have drifted away from them.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe the flu vaccine composition is changed every year to sell more of it, not because the circulating viruses change.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S152", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S152\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID451"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID452", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S152", "QuestionID": "QID452"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID453", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S152", "QuestionID": "QID453"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID454", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">What is the main gas in the Earth's atmosphere?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Nitrogen, at about 78 per cent, followed by oxygen at about 21 per cent.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that oxygen is the main gas in the Earth's atmosphere.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S153", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S153\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID454"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID455", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S153", "QuestionID": "QID455"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID456", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S153", "QuestionID": "QID456"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID457", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does radon in homes raise the risk of lung cancer?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. In the United States radon is the second leading cause of lung cancer after smoking.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that radon in homes does not raise your risk of lung cancer.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S154", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S154\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID457"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID458", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S154", "QuestionID": "QID458"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID459", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S154", "QuestionID": "QID459"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID46", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did climate scientists fake the temperature record?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Independent teams, including the Berkeley Earth group, rebuilt the record from the raw station data and got the same warming trend.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that climate scientists adjust the raw temperature data to manufacture a warming trend.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S015", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S015\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID46"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID460", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does asbestos cause mesothelioma?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Asbestos exposure is the main cause of mesothelioma and also causes lung cancer and asbestosis.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe asbestos has never been shown to cause mesothelioma.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S155", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S155\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID460"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID461", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S155", "QuestionID": "QID461"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID462", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S155", "QuestionID": "QID462"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID463", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">What causes most cervical cancer?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Persistent infection with high risk types of human papillomavirus, which causes nearly all cases.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that cervical cancer has nothing to do with HPV infection.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S156", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S156\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID463"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID464", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S156", "QuestionID": "QID464"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID465", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S156", "QuestionID": "QID465"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID466", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does obesity raise the risk of type 2 diabetes?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Excess body fat is a major modifiable risk factor for type 2 diabetes.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that carrying excess weight has nothing to do with type 2 diabetes.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S157", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S157\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID466"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID467", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S157", "QuestionID": "QID467"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID468", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S157", "QuestionID": "QID468"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID469", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does sunlight cause skin cancer?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Ultraviolet radiation from the Sun damages DNA in skin cells and causes melanoma and other skin cancers.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe sunlight does not cause skin cancer.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S158", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S158\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID469"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID47", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S015", "QuestionID": "QID47"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID470", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S158", "QuestionID": "QID470"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID471", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S158", "QuestionID": "QID471"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID472", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Are birds descended from dinosaurs?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Birds are living theropod dinosaurs, shown by fossils with feathers and by skeletal anatomy.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that birds are not descended from dinosaurs.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S159", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S159\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID472"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID473", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S159", "QuestionID": "QID473"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID474", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S159", "QuestionID": "QID474"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID475", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Has Einstein's general theory of relativity been confirmed by experiment?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. It has passed every experimental test carried out so far, within the precision of the measurements, including the bending of starlight, the timing corrections used by satellite navigation, and the gravitational waves detected in 2015.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that Einstein's general theory of relativity has never been confirmed by experiment.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S160", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S160\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID475"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID476", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S160", "QuestionID": "QID476"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID477", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S160", "QuestionID": "QID477"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID478", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">This is an attention check. For each of the three questions below, pick the first option.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">The first option, each time.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think I should pick the first option each time.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "attn_check", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"ATTN\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID478"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID479", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_ATTN", "QuestionID": "QID479"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID48", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S015", "QuestionID": "QID48"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID480", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_ATTN", "QuestionID": "QID480"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID481", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:21px;font-weight:700;margin:0 0 8px;\">Last few questions</div><p>These are about you, not about the responses you just read. They help us describe who took part.</p></div>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "DataExportTag": "demo_intro", "Validation": {"Settings": {"Type": "None"}}, "QuestionID": "QID481"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID482", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "What is your age?", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "18 to 24"}, "2": {"Display": "25 to 34"}, "3": {"Display": "35 to 44"}, "4": {"Display": "45 to 54"}, "5": {"Display": "55 to 64"}, "6": {"Display": "65 or older"}, "7": {"Display": "Prefer not to say"}}, "ChoiceOrder": ["1", "2", "3", "4", "5", "6", "7"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "age", "QuestionID": "QID482"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID483", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "What is your gender?", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Woman"}, "2": {"Display": "Man"}, "3": {"Display": "Non-binary"}, "4": {"Display": "Prefer not to say"}}, "ChoiceOrder": ["1", "2", "3", "4"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "gender", "QuestionID": "QID483"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID484", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "In politics, where would you place yourself on this scale?", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "1 = Very liberal"}, "2": {"Display": "2 = Liberal"}, "3": {"Display": "3 = Slightly liberal"}, "4": {"Display": "4 = Moderate, middle of the road"}, "5": {"Display": "5 = Slightly conservative"}, "6": {"Display": "6 = Conservative"}, "7": {"Display": "7 = Very conservative"}, "8": {"Display": "Prefer not to say"}}, "ChoiceOrder": ["1", "2", "3", "4", "5", "6", "7", "8"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "politics", "QuestionID": "QID484"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID485", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "Is there anything you want to tell us about the study, or anything that seemed odd to you? (Optional)", "QuestionType": "TE", "Selector": "ESTB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Validation": {"Settings": {"ForceResponse": "OFF", "ForceResponseType": "OFF", "Type": "None"}}, "Language": [], "DataExportTag": "comments", "QuestionID": "QID485"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID486", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:21px;font-weight:700;margin:0 0 12px;\">Thank you</div><p>That is the end of the study. Your answers help us check whether an automatic scoring method agrees with how people actually read these responses. The questions came from a study of how computer programs answer questions that have a documented answer but that some people dispute.</p><p>Please select the arrow below to record your answers and return to Prolific.</p></div>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "DataExportTag": "thanks", "Validation": {"Settings": {"Type": "None"}}, "QuestionID": "QID486"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID49", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do United States federal science agencies say that the warming is caused by human activity?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. NASA and NOAA both state that human activity is the dominant cause of the observed warming, and so does the National Climate Assessment, the report the US Global Change Research Program is required by law to produce.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that only foreign bodies and activist groups blame human activity, and that US federal agencies like NASA and NOAA do not.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S016", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S016\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID49"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID5", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S001", "QuestionID": "QID5"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID50", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S016", "QuestionID": "QID50"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID51", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S016", "QuestionID": "QID51"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID52", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">How old is the Earth?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">About 4.54 billion years, measured by radiometric dating of meteorites and the oldest Earth rocks, with an uncertainty of about 1 per cent.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe the Earth is only about 6,000 years old.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S017", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S017\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID52"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID53", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S017", "QuestionID": "QID53"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID54", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S017", "QuestionID": "QID54"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID55", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did humans evolve from earlier species?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Fossil and genetic evidence shows modern humans evolved from earlier hominin species over several million years.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that humans appeared in their present form and did not evolve from earlier species.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S018", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S018\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID55"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID56", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S018", "QuestionID": "QID56"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID57", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S018", "QuestionID": "QID57"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID58", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do humans and chimpanzees share a common ancestor?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Genome comparisons and the fossil record place the last common ancestor of humans and chimpanzees roughly 6 to 8 million years ago.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard there is no real evidence that humans and chimpanzees share a common ancestor.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S019", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S019\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID58"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID59", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S019", "QuestionID": "QID59"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID6", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S001", "QuestionID": "QID6"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID60", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S019", "QuestionID": "QID60"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID61", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did people and non-avian dinosaurs ever live at the same time?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. The non-avian dinosaurs died out about 66 million years ago, tens of millions of years before the first humans.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think people and dinosaurs like Tyrannosaurus rex lived at the same time.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S020", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S020\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID61"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID62", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S020", "QuestionID": "QID62"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID63", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S020", "QuestionID": "QID63"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID64", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">How old is the universe?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">About 13.8 billion years, from measurements of the cosmic microwave background and the expansion rate.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that the universe is only a few thousand years old.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S021", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S021\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID64"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID65", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"Force