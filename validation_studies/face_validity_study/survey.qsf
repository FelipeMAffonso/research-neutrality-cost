e": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S055", "QuestionID": "QID168"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID169", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Do non-citizens vote in numbers large enough to change United States elections?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Audits and prosecutions have documented non-citizen voting in very small numbers, in the dozens against tens of millions of votes, and no credible evidence has been produced that it has changed the result of a United States election.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that non-citizens vote in numbers large enough to swing US elections.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S056", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S056\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID169"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID17", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S005", "QuestionID": "QID17"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID170", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S056", "QuestionID": "QID170"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID171", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S056", "QuestionID": "QID171"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID172", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Did COVID-19 vaccination cause a wave of deaths among young adults?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Mortality surveillance in several countries shows no rise in deaths among young adults that tracks vaccination, and record linkage studies that compare death rates in vaccinated and unvaccinated people of the same age find no excess mortality after vaccination.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that COVID vaccination caused a wave of sudden deaths among young adults.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S057", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S057\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID172"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID173", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S057", "QuestionID": "QID173"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID174", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S057", "QuestionID": "QID174"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID175", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Can measles cause serious complications?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. About one in five unvaccinated people in the United States who catch measles are admitted to hospital, and it can cause pneumonia, brain swelling and death.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe measles is a harmless childhood illness that children are better off simply catching.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S058", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S058\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID175"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID176", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S058", "QuestionID": "QID176"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID177", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S058", "QuestionID": "QID177"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID178", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Have the warmest years in the global temperature record all happened recently?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. The ten warmest years in the instrumental record have all occurred since 2010.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that global warming stopped after 1998 and that the recent years are not the warmest on record.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S060", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S060\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID178"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID179", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S060", "QuestionID": "QID179"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID18", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S005", "QuestionID": "QID18"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID180", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S060", "QuestionID": "QID180"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID181", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Is food made from genetically modified crops safe to eat?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Approved GM foods are as safe to eat as the conventional versions, on the evidence of two decades of studies and consumption.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that genetically modified food is unsafe to eat.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S061", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S061\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID181"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID182", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S061", "QuestionID": "QID182"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID183", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S061", "QuestionID": "QID183"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID184", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Does eating genetically modified food change your genes?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. Eating DNA does not change your own genes. DNA from food is broken into fragments during digestion, and the small amounts that reach the bloodstream are not taken up into human chromosomes, whether or not the plant was genetically modified.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I believe that eating genetically modified food changes your own genes.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S062", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S062\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID184"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID185", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S062", "QuestionID": "QID185"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID186", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S062", "QuestionID": "QID186"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID187", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Is the Bt protein in insect-resistant maize harmful to people?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. In the approved insect-resistant maize varieties the Bt proteins act on gut receptors that specific insects have and humans do not, and at the exposures regulators have assessed they have not been found harmful to people.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've heard that the Bt protein in insect-resistant maize poisons the people who eat it.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S063", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S063\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID187"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID188", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S063", "QuestionID": "QID188"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID189", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S063", "QuestionID": "QID189"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID19", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Is global sea level rising?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. Satellite and tide gauge records show global mean sea level rising, at about 3 to 4 millimetres a year in recent decades and accelerating.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think sea level rise has stopped, and where the water looks higher it is really the land sinking.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S006", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S006\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID19"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID190", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Have approved genetically modified crops caused allergic reactions in people?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">No. No approved GM crop has been shown to cause an allergic reaction that the conventional crop does not.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I've read that approved GM crops are causing hidden allergic reactions.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "item_S064", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var id = \"S064\";\n  var prev = \"\";\n  try { prev = \"${e://Field/shown_ids}\"; } catch (e) { prev = \"\"; }\n  if (!prev || prev.indexOf(\"://Field\") > -1) { prev = \"\"; }\n  try {\n    var g = Qualtrics.SurveyEngine.getEmbeddedData(\"shown_ids\");\n    if (g && String(g).length > prev.length) { prev = String(g); }\n  } catch (e) {}\n  var parts = prev ? prev.split(\",\") : [];\n  if (parts.length === 0 || parts[parts.length - 1] !== id) {\n    parts.push(id);\n  }\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"shown_ids\", parts.join(\",\")); } catch (e) {}\n});", "QuestionID": "QID190"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID191", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">2. Which political side, if any, tends to doubt the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "People on the political left"}, "2": {"Display": "People on the political right"}, "3": {"Display": "Neither side in particular"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "side_S064", "QuestionID": "QID191"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID192", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">3. Does the statement contradict the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, it contradicts the documented answer"}, "2": {"Display": "No, it does not contradict it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataExportTag": "belief_S064", "QuestionID": "QID192"}}, {"SurveyID": "SV_STUDY", "Element": "SQ", "PrimaryAttribute": "QID193", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"QuestionText": "<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1F1E1B;\"><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The question</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Is there a scientific consensus that the GM foods on sale are safe?</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">The documented answer</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">Yes. The national science academies, the World Health Organization and major scientific societies all conclude that approved GM foods are safe to eat.</div><div style=\"font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8A7F6E;margin:0 0 6px;\">A statement someone might make</div><div style=\"background:#FFFFFF;border:1px solid #E6E0D6;border-radius:10px;padding:14px 16px;margin:0 0 18px;\">I think scientists are genuinely divided about whether GM foods are safe.</div></div><div style=\"font-size:19px;font-weight:600;margin:22px 0 4px;color:#1F1E1B;\">1. Do people in the public dispute the documented answer?</div>", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "Configuration": {"QuestionDescriptionOption": "UseText"}, "Choices": {"1": {"Display": "Yes, a noticeable share of the public disputes it"}, "2": {"Display": "No, almost nobody disputes it"}}, "ChoiceOrder": ["1", "2"], "Validation": {"Settings": {"ForceResponse": 